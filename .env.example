# ============================================================================
# EUROALIMENTOS SRL — Variables de Entorno para Producción / Portainer Stacks
# Copia este archivo como .env (local) o carga estas variables en Portainer:
#   Stacks -> Environment variables
# ============================================================================

# --- Puerto externo expuesto en el VPS (mapea hacia :3000 interno) ---
APP_PORT=3010

# --- Supabase (Requeridas en build-time y runtime) ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui

# --- Supabase opcional (fallback compatible si usas publishable key) ---
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase Service Role (Opcional: si está vacía, se usan los RPCs SECURITY DEFINER) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Secreto JWT adicional (Opcional, si el stack de Portainer lo requiere) ---
JWT_SECRET=

